---
/** Chamada no fim de cada post: leva para o WhatsApp com uma mensagem que já diz de onde veio. */
import Button from '@/components/ui/Button.astro';
import LinkUnderline from '@/components/ui/LinkUnderline.astro';
import { whatsappLink } from '@/data/site';
import { url } from '@/utils/url';

const mensagem = 'Olá, Asimov Jr.! Li o post do blog e quero conversar sobre um projeto.';
---

<section class="cta" aria-labelledby="cta-titulo">
  <div class="cta__coluna">
    <p class="mono">// sua vez</p>
    <h2 id="cta-titulo">Bora tirar sua ideia do papel?</h2>
    <div class="cta__acoes">
      <Button href={whatsappLink(mensagem)} variant="marinho" external>
        Falar no WhatsApp
      </Button>
      <LinkUnderline href={url()} line="marinho">
        ver o que a gente já fez →
      </LinkUnderline>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(56px, 8vw, 110px) var(--margem);
    background: var(--cor-azul);
    color: var(--cor-marinho);
  }
  .cta__coluna {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cta__coluna > p {
    font-size: 14px;
  }
  h2 {
    font: 800 clamp(40px, 5vw, 76px) / 0.95 var(--fonte-titulo);
    letter-spacing: -0.05em;
  }
  .cta__acoes {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 14px;
  }
  .cta__acoes :global(.btn--marinho:hover) {
    box-shadow: 3px 3px 0 var(--cor-branco);
  }
</style>
