---
/** Etapa 01: uma loja virtual se montando, do esboço ao "Novo pedido recebido". */
import CheckIcon from './CheckIcon.astro';

const esboco = [
  'left:6%;top:7%;width:16%;height:5%;--d:.18',
  'right:6%;top:7%;width:30%;height:5%;--d:.21',
  'left:6%;top:25%;width:46%;height:8%;--d:.24',
  'left:6%;top:36%;width:36%;height:8%;--d:.27',
  'left:6%;top:50%;width:42%;height:3.5%;--d:.30',
  'left:6%;top:56%;width:34%;height:3.5%;--d:.32',
  'left:6%;top:67%;width:20%;height:9%;border-radius:99px;--d:.35',
  'right:6%;top:21%;width:34%;height:60%;--d:.38',
];
---

<div class="mock" style="--p: var(--p0); --s: var(--s0, 1)">
  <div class="win">
    <div class="win__barra">
      <i></i>
      <i></i>
      <i></i>
      <span class="win__url">seunegocio.com.br</span>
    </div>
    <div class="win__corpo">
      <div class="camada camada--esboco">
        {esboco.map((s) => (
          <div class="sk ap" style={s} />
        ))}
      </div>

      <div class="camada camada--final">
        <div class="site__nav">
          <b>sua·loja</b>
          <span>
            <span>Produtos</span>
            <span>Sobre</span>
            <span>Contato</span>
          </span>
        </div>
        <div class="site__texto">
          <p class="site__titulo">Seu produto na mão de quem procura.</p>
          <p class="site__sub">Entrega pra todo o Brasil e pagamento em um clique.</p>
          <span class="site__botao">Comprar agora</span>
        </div>
        <div class="site__foto">
          <div></div>
        </div>
      </div>

      <svg class="site__cursor" width="22" height="22" viewBox="0 0 24 24">
        <path
          d="M3 2l16 9-7 2-3 7z"
          fill="#0F142C"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linejoin="round"
        ></path>
      </svg>

      <div class="aviso site__aviso">
        <CheckIcon />
        Novo pedido recebido
      </div>
    </div>
  </div>
</div>

<style>
  .site__nav {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site__nav b {
    font: 800 3cqw var(--fonte-titulo);
  }
  .site__nav > span {
    display: flex;
    gap: 3cqw;
    font: 500 2cqw var(--fonte-texto);
  }
  .site__texto {
    position: absolute;
    left: 6%;
    top: 23%;
    width: 50%;
  }
  .site__titulo {
    font: 700 5.2cqw/1.06 var(--fonte-titulo);
    letter-spacing: -0.03em;
  }
  .site__sub {
    margin-top: 2.2cqw;
    font: 400 2.2cqw/1.45 var(--fonte-texto);
    color: var(--cor-texto-suave);
  }
  .site__botao {
    display: inline-block;
    margin-top: 3.2cqw;
    padding: 1.7cqw 3.2cqw;
    border-radius: var(--raio-pilula);
    background: var(--cor-azul);
    font: 700 2.2cqw var(--fonte-texto);
    box-shadow: 0 0 0 calc(clamp(0, (var(--p, 0) - 0.8) * 10, 1) * 1cqw) rgb(0 127 255 / 0.3);
  }
  .site__foto {
    position: absolute;
    right: 6%;
    top: 20%;
    width: 34%;
    height: 62%;
    display: grid;
    place-items: center;
    background: var(--cor-azul);
    border-radius: 2cqw;
  }
  .site__foto div {
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cor-marinho);
    box-shadow: 0 0 0 3cqw rgb(255 255 255 / 0.28);
  }
  .site__cursor {
    --c: clamp(0, (var(--p, 0) - 0.58) * 4.5, 1);
    position: absolute;
    left: calc(84% - var(--c) * 66%);
    top: calc(92% - var(--c) * 20%);
    opacity: clamp(0, (var(--p, 0) - 0.55) * 10, 1);
  }
  .site__aviso {
    right: 4%;
    top: 5%;
    gap: 1.4cqw;
    padding: 1.5cqw 2.4cqw;
    border-radius: 2cqw;
    font-size: 2cqw;
    transform: translateY(calc((1 - var(--ap)) * -14px));
  }
</style>
