---
/**
 * Hero: logo de partículas, selo do prêmio, chamada e o "ASIMOV JR." gigante.
 * A seção tem 170vh de altura com o conteúdo grudado na tela; conforme rola,
 * as partículas se espalham e o texto sai de cena.
 */
import LinkUnderline from '@/components/ui/LinkUnderline.astro';
import { destaques } from '@/data/destaques';
---

<section id="inicio" class="hero" data-hero>
  <div class="hero__sticky">
    <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>

    <p class="mono hero__selo">{destaques.premio}</p>

    <div class="hero__copy">
      <div class="hero__texto">
        <p class="mono hero__pos">// {destaques.posicionamento}</p>
        <p class="hero__chamada">
          {destaques.chamada[0]}
          <br />
          {destaques.chamada[1]}
        </p>
      </div>
      <LinkUnderline href="#pedido" class="hero__ver">
        ver a gente fazendo ↓
      </LinkUnderline>
    </div>

    <h1 class="hero__nome">
      <span class="hero__mascara">
        <span class="hero__sobe">ASIMOV JR.</span>
      </span>
    </h1>
  </div>
</section>

<script>
  import { LogoParticulas } from '@/scripts/particulas';
  import {
    clamp,
    onScrollFrame,
    prefersReducedMotion,
    setVar,
    smooth,
    stickyProgress,
  } from '@/scripts/scroll';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  if (hero && canvas) {
    let logo: LogoParticulas | null = null;
    try {
      logo = new LogoParticulas(canvas, { parado: prefersReducedMotion() });
    } catch {
      // Sem canvas 2D: a hero continua funcionando, só sem o logo animado.
    }

    onScrollFrame(() => {
      const p = stickyProgress(hero);
      setVar(hero, '--hero', p);
      logo?.setExplode(smooth(clamp((p - 0.04) / 0.8, 0, 1)));
    });
  }
</script>

<style>
  .hero {
    position: relative;
    height: 170vh;
    background: var(--cor-marinho);
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: var(--cor-branco);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .hero__selo {
    position: absolute;
    top: clamp(86px, 12vh, 104px);
    left: var(--margem);
    right: var(--margem);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.85);
  }
  .hero__copy {
    position: absolute;
    left: var(--margem);
    right: var(--margem);
    bottom: calc(14.6vw + 40px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    opacity: calc(1 - var(--hero, 0) * 3.5);
  }
  .hero__texto {
    max-width: 520px;
  }
  .hero__pos {
    margin-bottom: 14px;
    font-size: 14px;
    color: var(--cor-azul-claro);
  }
  .hero__chamada {
    font: 500 clamp(20px, 2.1vw, 30px) / 1.3 var(--fonte-texto);
  }
  .hero__nome {
    position: absolute;
    left: 1.6vw;
    bottom: -0.02em;
    font: 200 16.3vw / 0.8 var(--fonte-titulo);
    letter-spacing: -0.05em;
    white-space: nowrap;
    transform: translateY(calc(var(--hero, 0) * -8vh));
    opacity: calc(1 - var(--hero, 0) * 1.4);
  }
  .hero__mascara {
    display: inline-block;
    overflow: hidden;
    padding-top: 0.06em;
    vertical-align: bottom;
  }
  .hero__sobe {
    display: inline-block;
    animation: sobe 1.1s var(--curva-saida) 0.15s both;
  }
  @keyframes sobe {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }

  .hero__copy :global(.hero__ver) {
    color: var(--cor-branco);
  }

  @media (max-width: 760px) {
    .hero__copy {
      bottom: calc(16.3vw + 22px);
    }
    .hero__copy :global(.hero__ver) {
      display: none;
    }
  }
</style>
