---
/** Setas usadas em botões e links. Sempre decorativas. */
interface Props {
  direction?: 'diagonal' | 'right';
  size?: number;
}

const { direction = 'diagonal', size = 15 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  aria-hidden="true"
>
  {direction === 'diagonal' ? <path d="M4 12L12 4M5 4h7v7" /> : <path d="M2 8h11M9 4l4 4-4 4" />}
</svg>
