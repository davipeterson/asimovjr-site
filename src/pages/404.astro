---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LinkUnderline from '@/components/ui/LinkUnderline.astro';
import { url } from '@/utils/url';
---

<BaseLayout title="Página não encontrada" footerBack={{ href: url(), label: '← voltar pra home' }}>
  <main class="nf">
    <p class="mono tag">// erro 404</p>
    <h1>Essa página não existe.</h1>
    <LinkUnderline href={url()}>voltar pra home →</LinkUnderline>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 22px;
    padding: 0 var(--margem);
  }
  .tag {
    font-size: 14px;
    color: var(--cor-azul-claro);
  }
  h1 {
    font: 800 clamp(44px, 8vw, 120px) / 0.95 var(--fonte-titulo);
    letter-spacing: -0.05em;
  }
</style>
