---
/**
 * Guia de estilo interno: mostra cores, fontes e componentes base para revisão.
 * Não aparece no Google nem no sitemap.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import LinkUnderline from '@/components/ui/LinkUnderline.astro';
import AsimovSymbol from '@/components/ui/AsimovSymbol.astro';

const cores = [
  { nome: 'Azul', token: '--cor-azul', hex: '#007FFF', marca: true },
  { nome: 'Marinho', token: '--cor-marinho', hex: '#0F142C', marca: true },
  { nome: 'Branco', token: '--cor-branco', hex: '#FFFFFF', marca: true },
  { nome: 'Azul claro', token: '--cor-azul-claro', hex: '#6FB6FF', marca: false },
  { nome: 'Cinza claro', token: '--cor-cinza-claro', hex: '#F3F5FA', marca: false },
  { nome: 'Linha', token: '--cor-linha', hex: '#E2E6EF', marca: false },
  { nome: 'Texto suave', token: '--cor-texto-suave', hex: '#3D4259', marca: false },
];
---

<BaseLayout title="Guia de estilo" noindex>
  <main class="guia">
    <header class="topo">
      <p class="mono rotulo">// guia de estilo</p>
      <h1>Base visual</h1>
      <p class="intro">
        Cores, fontes e peças do manual de marca, como estão no código. Página interna, fora do
        Google.
      </p>
    </header>

    <section aria-labelledby="t-cores">
      <h2 id="t-cores">Cores</h2>
      <ul class="cores">
        {cores.map((c) => (
          <li>
            <span class="amostra" style={`background:var(${c.token})`} />
            <strong>{c.nome}</strong>
            <code>{c.token}</code>
            <code>{c.hex}</code>
            <span class="mono selo">{c.marca ? 'manual' : 'apoio'}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="t-tipo">
      <h2 id="t-tipo">Tipografia</h2>
      <div class="tipos">
        <p class="t-titulo-800">Poppins 800 · títulos</p>
        <p class="t-titulo-200">Poppins 200 · ASIMOV JR.</p>
        <p class="t-texto">
          DM Sans · texto corrido. Sites, apps, sistemas e dados. Com preço de empresa júnior.
        </p>
        <p class="mono t-mono">DM Mono · detalhes, rótulos e o terminal</p>
      </div>
    </section>

    <section aria-labelledby="t-comp">
      <h2 id="t-comp">Componentes</h2>
      <div class="paineis">
        <div class="comp">
          <Button href="#">Botão azul</Button>
          <LinkUnderline href="#">link sublinhado →</LinkUnderline>
          <AsimovSymbol size={64} label="Símbolo da Asimov Jr." />
        </div>
        <div class="comp comp--claro">
          <Button href="#" variant="marinho">
            Botão marinho
          </Button>
          <Button href="#">Botão azul</Button>
          <AsimovSymbol size={64} />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .guia {
    padding: clamp(120px, 16vh, 160px) var(--margem) 80px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .rotulo {
    font-size: 14px;
    color: var(--cor-azul-claro);
  }
  h1 {
    margin-top: 8px;
    font: 800 clamp(48px, 8vw, 112px) / 0.95 var(--fonte-titulo);
    letter-spacing: -0.05em;
  }
  .intro {
    margin-top: 16px;
    max-width: 560px;
    color: rgb(255 255 255 / 0.82);
  }
  h2 {
    margin-bottom: 20px;
    font: 700 clamp(24px, 2.4vw, 32px) / 1.1 var(--fonte-titulo);
    letter-spacing: -0.03em;
  }
  .cores {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }
  .cores li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
  }
  .amostra {
    height: 84px;
    margin-bottom: 8px;
    border: 2px solid rgb(255 255 255 / 0.25);
    border-radius: var(--raio-m);
  }
  code {
    font-family: var(--fonte-mono);
    font-size: 13px;
    color: rgb(255 255 255 / 0.8);
  }
  .selo {
    align-self: flex-start;
    margin-top: 4px;
    padding: 2px 8px;
    border-radius: var(--raio-p);
    background: rgb(255 255 255 / 0.1);
    font-size: 12px;
  }
  .tipos {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .t-titulo-800 {
    font: 800 clamp(32px, 4vw, 56px) / 1 var(--fonte-titulo);
    letter-spacing: -0.04em;
  }
  .t-titulo-200 {
    font: 200 clamp(32px, 4vw, 56px) / 1 var(--fonte-titulo);
    letter-spacing: -0.04em;
  }
  .t-texto {
    max-width: 620px;
    font-size: 19px;
    line-height: 1.6;
  }
  .t-mono {
    font-size: 15px;
    color: var(--cor-azul-claro);
  }
  .paineis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }
  .comp {
    padding: 28px;
    border: 2px solid rgb(255 255 255 / 0.18);
    border-radius: var(--raio-g);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }
  .comp--claro {
    background: var(--cor-branco);
    border-color: var(--cor-branco);
    color: var(--cor-marinho);
  }
</style>
