---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="placeholder">
    <p class="mono tag">// em construção</p>
    <h1>Asimov Jr.</h1>
    <p>A home nova entra aqui, uma seção por vez.</p>
  </main>
</BaseLayout>

<style>
  .placeholder {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 0 var(--margem);
  }
  .tag {
    font-size: 14px;
    color: var(--cor-azul-claro);
  }
  h1 {
    font: 200 clamp(64px, 16vw, 240px) / 0.85 var(--fonte-titulo);
    letter-spacing: -0.05em;
  }
  p:last-child {
    font-size: clamp(17px, 1.6vw, 22px);
    color: rgb(255 255 255 / 0.82);
  }
</style>
