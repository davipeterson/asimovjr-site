# Modelo de .htaccess para a Hostinger.
# Na migração, copie este arquivo para public/.htaccess (ele vai junto no build).

# Sempre HTTPS e sem "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://asimovjr.com.br%{REQUEST_URI} [L,R=301]

# Página 404 do próprio site
ErrorDocument 404 /404.html

# Endereços do site antigo (WordPress) que ainda podem estar no Google ou em links salvos
Redirect 301 /o-proposito-da-asimov-mais-do-que-sites-solucoes-digitais-2/ /blog/o-proposito-da-asimov/

# Cache: arquivos de /_astro/ têm nome com hash e nunca mudam
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
